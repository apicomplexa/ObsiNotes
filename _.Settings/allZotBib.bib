@article{xuePainBehaviorSCN9A2021,
  title = {Pain Behavior in {{{\mkbibemph{SCN9A}}}} ({{Nav1}}.7) and {{{\mkbibemph{SCN10A}}}} ({{Nav1}}.8) Mutant Rodent Models},
  author = {Xue, Yaping and Chidiac, Celeste and Herault, Yann and Gaveriaux-Ruff, Claire},
