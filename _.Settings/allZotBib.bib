@article{bukovacBilateralMeningiomaCase2022,
  title = {Bilateral {{Meningioma}}: {{A Case Report}} and {{Review}} of the {{Literature}}},
  shorttitle = {Bilateral {{Meningioma}}},
  author = {Bukovac, Anja and Panić, Hana and Mrgan, Tomislava and Šlaus, Nika and Kafka, Anja and Njirić, Niko and Pećina-Šlaus, Nives},
  date = {2022-01},
  journaltitle = {International Journal of Molecular Sciences},
  volume = {23},
