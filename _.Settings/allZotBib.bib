@article{gansaugeSinglestrandedDNALibrary2013,
  title = {Single-Stranded {{DNA}} Library Preparation for the Sequencing of Ancient or Damaged {{DNA}}},
  author = {Gansauge, Marie-Theres and Meyer, Matthias},
