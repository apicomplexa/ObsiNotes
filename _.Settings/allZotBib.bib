@article{ibragimovaALL096FamilialCases2024,
  title = {{{ALL-096 Familial Cases}} of {{Acute Leukemia}} in {{Children}} in {{Uzbekistan}}},
  author = {Ibragimova, Sapura and Burhoniddinova, Movluda and Kasimbekova, Lola},
  date = {2024-09-01},
  journaltitle = {Clinical Lymphoma Myeloma and Leukemia},
  shortjournal = {Clinical Lymphoma Myeloma and Leukemia},
  series = {Proceedings of the {{Society}} of {{Hematologic Oncology}} 2024 {{Annual Meeting}}},
  volume = {24},
  pages = {S259},
  issn = {2152-2650},
  doi = {10.1016/S2152-2650(24)01087-5},
  url = {https://www.sciencedirect.com/science/article/pii/S2152265024010875},
  urldate = {2025-04-27},
  abstract = {Background Siblings of children with leukemia are at greater risk of developing leukemia than children whose siblings do not have the disease (Draper et al, 1977; Heath and Moloney, 1965). We aimed to assess the risk of developing acute leukemia in siblings of patients in a single-center study by studying the role of family history of cancer in the etiology of acute leukemia in children. Methods The study involved 1550 children aged {$<$}15 years with acute leukemia: 1300 (83.9\%) with acute lymphoblastic leukemia (ALL) and 250 (16.1\%) with acute myeloblastic leukemia (AML) who received treatment from 2018 to 2023 at the Center for Pediatric Hematology, Oncology and Clinical Immunology in Tashkent, Uzbekistan. All the leukemia cases were confirmed by bone marrow analysis. All patients were examined by immunological, molecular genetic, and cytogenetic studies; the desired translocations were not identified. All patients had no hereditary burden of blood diseases. The familial history of cancer was collected for the first-degree (siblings) relatives for children with childhood leukemia who were diagnosed with the same (concordant) or different (discordant) cancer. Results During the study period, 12 familial cases were identified with acute leukemia (0.8\%, 12/1550), and 2 of the cases were in identical samesex twins (male-male and female-female). Among 1550 patients with acute leukemia, 6 patients with ALL (including twins) had a family history of ALL, that is, 0.4\% (6/1550), and 2 patients with ALL had a family history of AML. Four children (0.3\%, 4/1550) were diagnosed with AML when 2 first-degree relatives were diagnosed with the same leukemia (AML). Two siblings were diagnosed with ALL at an age {$<$}15 years. We showed that 0.5\% of childhood patients with ALL and 0.3\% of childhood patients with AML had a family history of acute leukemia that was in line with familial proportions for other rare cancers. Conclusion These studies suggest that genetic factors and family history of cancer may play a role in the etiology of acute leukemia in children. Perhaps in the future it will be necessary to examine patients and close family members using the NHS method to identify characteristic mutations as risk factors.},
  file = {C:\Users\Alex\Zotero\storage\UGSKBDSW\S2152265024010875.html}
}

