  title = {Two Independent Pathways of Maternal Cell Transmission to Offspring: Through Placenta during Pregnancy and by Breast‐feeding after Birth},
  shorttitle = {Two Independent Pathways of Maternal Cell Transmission to Offspring},
  author = {Zhou, L. and Yoshimura, Y. and Huang, Y.‐Y. and Suzuki, R. and Yokoyama, M. and Okabe, M. and Shimamura, M.},
  date = {2000-12},
  journaltitle = {Immunology},
  shortjournal = {Immunology},
  volume = {101},
  number = {4},
