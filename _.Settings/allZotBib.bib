@online{OsteomaMyshchelkovogoOtrostka2017,
  title = {Остеома мыщелкового отростка. Клинический случай.},
  date = {2017-09-21T15:21:17+03:00},
  url = {https://tomograf.ua/ru/osteoma-myshhelkovogo-otrostka-klinicheskij-sluchaj/},
  urldate = {2025-04-04},
  abstract = {Остеома — это довольно медленно развивающаяся доброкачественная опухоль костной ткани.~ Чаще всего данное заболевание встречается у детей и подростков, однако не исключены случаи возникновения и во взрослом возрасте. Локализируется опухоль в основном на костях черепа. По происхождению отличают два вида остеом: Гиперпластические остеомы — опухоли которые развиваются из костной ткани. К этой группе можно отнести остеомы (опухоли ничем не отличающиеся от обычной костной ткани) и остеоидные остеомы (опухоли, которые состоят из хаотично расположенных костных участков и зон остеолиза). Гетеропластические остеомы — опухоли которые развиваются из соединительной ткани. Остеома — клинические проявления, диагностика и лечение Клинические проявления остеом прежде всего зависят от локализации. Чаще всего данный вид опухоли протекает бессимптомно до тех пор, пока размер не приведет к сдавливанию или функциональному нарушению соседних анатомических образований. Диагностировать остеомы можно визуально (если они расположены на внешней стороне кости), при помощи рентгенологического снимка, компьютерной томографии и магнитно-резонансной томографии. Золотым стандартом в диагностике остеом является конусно-лучевая компьютерная томография. Благодаря данному виду диагностики можно получить детализированное трехмерное изображение и спланировать лечение. Лечение остеом только хирургическое. Прогноз лечения положительный. Остеома мыщелкового отростка. Клинический случай. У нас в Central Laboratory diagnosis of the head диагностирован интересный клинический случай остеомы мыщелкового отростка — остеогенной опухоли, состоящей из зрелой кости. На снимках фронтальные, поперечные, сагитальные срезы черепа пациента на которых отчетливо визуализируется остеома мыщелкового отростка справа. ~ Рис.1 Конусно-лучевая компьютерная томография (КЛКТ) черепа пациента с осетеомой мыщелкового отростка справа. Рис. 2. Конусно лучевая компьютерная томография и 3D визуализация нижней челюсти с остеомой мыщелкового отростка справа.},
  langid = {russian},
  organization = {CLDH},
  file = {C:\Users\Alex\Zotero\storage\TL7CCL7H\osteoma-myshhelkovogo-otrostka-klinicheskij-sluchaj.html}
}

@article{paaboGeneticAnalysesAncient2004,
  title = {Genetic {{Analyses}} from {{Ancient DNA}}},
  author = {Pääbo, Svante and Poinar, Hendrik and Serre, David and Jaenicke-Després, Viviane and Hebler, Juliane and Rohland, Nadin and Kuch, Melanie and Krause, Johannes and Vigilant, Linda and Hofreiter, Michael},
  date = {2004},
  journaltitle = {Annual Review of Genetics},
  volume = {38},
  number = {1},
  eprint = {15568989},
  eprinttype = {pubmed},
  pages = {645--679},
  doi = {10.1146/annurev.genet.37.110801.143214},
  url = {https://doi.org/10.1146/annurev.genet.37.110801.143214},
  urldate = {2024-01-08},
  abstract = {About 20 years ago, DNA sequences were separately described from the quagga (a type of zebra) and an ancient Egyptian individual. What made these DNA sequences exceptional was that they were derived from 140- and 2400-year-old specimens. However, ancient DNA research, defined broadly as the retrieval of DNA sequences from museum specimens, archaeological finds, fossil remains, and other unusual sources of DNA, only really became feasible with the advent of techniques for the enzymatic amplification of specific DNA sequences. Today, reports of analyses of specimens hundreds, thousands, and even millions of years old are almost commonplace. But can all these results be believed? In this paper, we critically assess the state of ancient DNA research. In particular, we discuss the precautions and criteria necessary to ascertain to the greatest extent possible that results represent authentic ancient DNA sequences. We also highlight some significant results and areas of promising future research.},
  file = {C:\Users\Alex\Zotero\storage\L98BTNFR\Pääbo_et_al_2004_Genetic_Analyses_from_Ancient_DNA.pdf}
}

@article{patelMelatoninAssociatedFacialSwelling2020,
  title = {Melatonin-{{Associated Facial Swelling}} in an {{Oncology Patient}}: {{Case Report}} and {{Review}} of {{Swelling}} of the {{Face}} in {{Individuals With Head}} and {{Neck Cancer}}},
  shorttitle = {Melatonin-{{Associated Facial Swelling}} in an {{Oncology Patient}}},
  author = {Patel, Ravi C and Kubicki, Shelby L and Cohen, Philip R and MacFarlane, Deborah F},
  date = {2020-10-09},
  journaltitle = {Cureus},
  issn = {2168-8184},
  doi = {10.7759/cureus.10866},
  url = {https://www.cureus.com/articles/41376-melatonin-associated-facial-swelling-in-an-oncology-patient-case-report-and-review-of-swelling-of-the-face-in-individuals-with-head-and-neck-cancer},
  urldate = {2025-04-04},
  abstract = {Facial swelling has several etiologies. In patients with head and neck malignancies, this can include primary disease progression or iatrogenic causes. A 66-year-old man presented with increased facial swelling and erythema for 18 months. He had a history of baseline postoperative facial lymphedema following head and neck surgery and radiotherapy for desmoplastic melanoma approximately 20 years ago. However, his facial edema acutely worsened 18 months prior to presentation. A medication review revealed that he was regularly taking melatonin for the past two years. Approximately two weeks after cessation of melatonin therapy, the patient’s facial appearance returned to baseline. In conclusion, it is important for clinicians to perform a thorough medication review for patients with facial swelling and erythema.},
  langid = {english},
