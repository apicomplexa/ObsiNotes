@article{charrotAMLPrismMolecular2020,
  title = {{{AML}} through the Prism of Molecular Genetics},
  author = {Charrot, Sarah and Armes, Hannah and Rio-Machin, Ana and Fitzgibbon, Jude},
  date = {2020},
  journaltitle = {British Journal of Haematology},
  volume = {188},
  number = {1},
