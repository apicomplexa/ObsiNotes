@article{simTWEAKFn14Signalling2024,
  title = {{{TWEAK}}/{{Fn14}} Signalling Driven Super-Enhancer Reprogramming Promotes pro-Metastatic Metabolic Rewiring in Triple-Negative Breast Cancer},
  author = {Sim, Nicholas and Carter, Jean-Michel and Deka, Kamalakshi and Tan, Benita Kiat Tee and Sim, Yirong and Tan, Suet-Mien and Li, Yinghui},
  date = {2024-07-05},
  journaltitle = {Nature Communications},
