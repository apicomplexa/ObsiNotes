@article{aungPrimaryMalignantMelanoma2024,
  title = {Primary Malignant Melanoma of the Parotid Gland, a Rare Case Arising from a Duct: A Case Report and Literature Review},
  shorttitle = {Primary Malignant Melanoma of the Parotid Gland, a Rare Case Arising from a Duct},
  author = {Aung, Moe Thu Zar and Kim, Jo-Eun and Yoon, Hye-Jung and Huh, Kyoung-Hoe and Yi, Won-Jin and Heo, Min-Suk and Lee, Sam-Sun},
  date = {2024-06-06},
  journaltitle = {Frontiers in Oncology},
  shortjournal = {Front. Oncol.},
  volume = {14},
  publisher = {Frontiers},
  issn = {2234-943X},
  doi = {10.3389/fonc.2024.1324214},
  url = {https://www.frontiersin.org/journals/oncology/articles/10.3389/fonc.2024.1324214/full},
  urldate = {2025-04-04},
  abstract = {Malignant melanoma of the parotid gland is an unusual tumor in the head and neck region, and most parotid melanoma is reported as a metastatic lesion of cutaneous malignant melanoma. We report a case of primary malignant melanoma arising in the parotid gland duct with diagnostic challenge. The patient was a 68-year-old man who complained of repeated right facial swelling that presented 3 months prior. Swelling was detected along the Stensen’s duct of the cheek, and brown-colored saliva-like fluid was aspirated. On MR and CT images, a fluid-filled duct with small nodule and heterogeneously enhancing mass in the parotid parenchyma was detected. The nodular mass on the ductal wall grew rapidly, and the hyperintense T1 signal became significant on follow-up images. The final diagnosis via histopathologic examination using biopsy and parotidectomy specimen revealed the lesion as malignant melanoma of the duct and pleomorphic adenoma of the parenchyma. Even if the incidence of primary malignant melanoma is very low among tumors occurring in the parotid gland, efforts supporting an early diagnosis using imaging characteristics are important.},
  langid = {english},
  file = {C:\Users\Alex\Zotero\storage\2BE4FCJH\Aung_et_al_2024_Primary_malignant_melanoma_of_the_parotid_gland,_a_rare_case_arising_from_a_duct.pdf}
}

