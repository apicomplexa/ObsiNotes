  pmcid = {PMC6379049},
  file = {C:\Users\Alex\Zotero\storage\XYQUPJRU\Wang_et_al_2019_A_deep_proteome_and_transcriptome_abundance_atlas_of_29_healthy_human_tissues.pdf}
}

