  "fileRules": [
    {
      "id": "GMzZI",
      "name": "Index",
      "match": "all",
      "conditions": [
        {
          "source": "property:type",
          "operator": "contains",
          "value": "index"
        }
      ],
      "enabled": true,
      "icon": "lucide-compass"
    },
    {
      "id": "xDu7Q",
      "name": "BI tools",
      "match": "all",
      "conditions": [
        {
          "source": "property:💻Bioinfo",
          "operator": "includes",
          "value": "tool"
        }
      ],
      "enabled": true,
      "icon": "ms-code"
    },
    {
      "id": "YHWSJ",
      "name": "GRW",
      "match": "all",
      "conditions": [
        {
          "source": "tags",
          "operator": "allContain",
          "value": "grw"
        }
      ],
      "enabled": true,
      "icon": "lucide-film"
    },
    {
      "id": "rYyMm",
      "name": "Список",
      "match": "all",
      "conditions": [
        {
          "source": "property:type",
          "operator": "contains",
          "value": "task"
        }
      ],
      "enabled": true,
      "icon": "lucide-list-todo"
    },
    {
      "id": "HMJiC",
      "name": "Excalidraw",
      "match": "all",
      "conditions": [
        {
          "source": "name",
          "operator": "contains",
          "value": ".excalidraw"
        }
      ],
      "enabled": true,
      "icon": "lucide-file-pen"
    },
    {
      "id": "qbEWh",
      "name": "not md",
      "match": "all",
      "conditions": [
        {
          "source": "extension",
          "operator": "!is",
          "value": "md"
        },
        {
          "source": "path",
          "operator": "!contains",
          "value": "Media"
        },
        {
          "source": "extension",
          "operator": "!is",
          "value": "base"
        }
      ],
      "enabled": true,
      "icon": "lucide-file-plus"
    },
    {
      "id": "GesSZ",
      "name": "Base",
      "match": "all",
      "conditions": [
        {
          "source": "extension",
          "operator": "is",
          "value": "base"
        }
      ],
      "enabled": true,
      "icon": "lucide-database-zap"
    }
  ],
  "folderRules": [
    {
      "id": "4OXIZ",
      "name": "Index",
      "match": "all",
      "conditions": [
        {
          "source": "path",
          "operator": "contains",
          "value": "Indexes"
        }
      ],
      "enabled": true,
      "icon": "lucide-compass",
      "color": "red"
    }
  ],
  "biggerSearchResults": "mobile",
  "rememberDeletedItems": false
}